<UserControl x:Class="WhisperStt.Desktop.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- A color: a swatch that opens red/green/blue/opacity sliders, and the color typed as #RRGGBB or #AARRGGBB -->
    <UserControl.Resources>
        <DrawingBrush x:Key="Checkers" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#CCCCCC" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="ChannelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="ChannelValue" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,8,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToggleButton x:Name="SwatchButton" DockPanel.Dock="Right" Width="34" Height="28" Margin="8,0,0,0" Cursor="Hand"
                      AutomationProperties.Name="Choose a color" ToolTip="Choose a color">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource DialogStrokeBrush}" Background="{StaticResource Checkers}">
                        <Border x:Name="Swatch" CornerRadius="5" Background="{Binding SwatchBrush, ElementName=Root}" />
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <TextBox x:Name="HexBox" VerticalContentAlignment="Center" FontSize="12"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                 ToolTip="#RRGGBB, or #AARRGGBB with the opacity first" />
        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" HorizontalOffset="-250"
               StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=SwatchButton}">
            <Border Width="284" Margin="0,6,10,12" Padding="14,12" CornerRadius="10" Background="{DynamicResource DialogBrush}"
                    BorderBrush="{DynamicResource DialogStrokeBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <Border Height="42" CornerRadius="8" Background="{StaticResource Checkers}" Margin="0,0,0,4">
                        <Border CornerRadius="8" Background="{Binding SwatchBrush, ElementName=Root}" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Red" Style="{StaticResource ChannelLabel}" />
                        <Slider x:Name="Red" Grid.Column="1" Style="{StaticResource BrandSlider}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0" AutomationProperties.Name="Red" />
                        <TextBox x:Name="RedBox" Grid.Column="2" Style="{StaticResource ChannelValue}" />
                        <TextBlock Grid.Row="1" Text="Green" Style="{StaticResource ChannelLabel}" />
                        <Slider x:Name="Green" Grid.Row="1" Grid.Column="1" Style="{StaticResource BrandSlider}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0" AutomationProperties.Name="Green" />
                        <TextBox x:Name="GreenBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChannelValue}" />
                        <TextBlock Grid.Row="2" Text="Blue" Style="{StaticResource ChannelLabel}" />
                        <Slider x:Name="Blue" Grid.Row="2" Grid.Column="1" Style="{StaticResource BrandSlider}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0" AutomationProperties.Name="Blue" />
                        <TextBox x:Name="BlueBox" Grid.Row="2" Grid.Column="2" Style="{StaticResource ChannelValue}" />
                        <TextBlock Grid.Row="3" Text="Opacity" Style="{StaticResource ChannelLabel}" />
                        <Slider x:Name="Alpha" Grid.Row="3" Grid.Column="1" Style="{StaticResource BrandSlider}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0" AutomationProperties.Name="Opacity" />
                        <TextBox x:Name="AlphaBox" Grid.Row="3" Grid.Column="2" Style="{StaticResource ChannelValue}" ToolTip="0 is invisible, 255 is solid" />
                    </Grid>
                    <ItemsControl x:Name="Presets" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="22" Margin="2" Cursor="Hand" Tag="{Binding}" Click="Preset_Click" ToolTip="{Binding}"
                                        AutomationProperties.Name="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource DialogStrokeBrush}" Background="{StaticResource Checkers}">
                                                <Border CornerRadius="3" Background="{Binding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
