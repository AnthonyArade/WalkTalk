<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the setup exe, which the build uploads as a zip holding
     only WalkTalk-Setup-<version>.exe.
     Inno Setup pads the setup exe's product name and version with spaces ("WalkTalk      "). If SignPath
     rejects the file over them, its error says so: then remove product-name and product-version below. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="WalkTalk-Setup-${version}.exe" product-name="WalkTalk" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
