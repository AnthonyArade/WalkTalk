<UserControl x:Class="WhisperStt.Desktop.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- A color: a swatch that opens a picker (saturation/brightness field, hue bar, opacity bar, red/green/blue/opacity
         boxes), and the color typed as #RRGGBB or #AARRGGBB -->
    <UserControl.Resources>
        <DrawingBrush x:Key="Checkers" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#CCCCCC" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- The round handle on the field and the bars: white ring around the current color -->
        <Style x:Key="Handle" TargetType="Ellipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.6" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChannelBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#5CE0A8" />
            <Setter Property="Background" Value="#1E2A2A" />
            <Setter Property="BorderBrush" Value="#2E4A44" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToggleButton x:Name="SwatchButton" DockPanel.Dock="Right" Width="34" Height="28" Margin="8,0,0,0" Cursor="Hand"
                      AutomationProperties.Name="Choose a color" ToolTip="Choose a color">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource DialogStrokeBrush}" Background="{StaticResource Checkers}">
                        <Border CornerRadius="5" Background="{Binding SwatchBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <TextBox x:Name="HexBox" VerticalContentAlignment="Center" FontSize="12"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                 ToolTip="#RRGGBB, or #AARRGGBB with the opacity first" />
        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" HorizontalOffset="-210"
               StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=SwatchButton}">
            <Border Width="244" Margin="0,6,10,12" Padding="10" CornerRadius="12" Background="#1A1B1E"
                    BorderBrush="#33FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <!-- Saturation (left to right) and brightness (top to bottom) for the current hue -->
                    <Grid x:Name="Field" Height="170" Cursor="Cross" Background="Transparent" ClipToBounds="False"
                          MouseLeftButtonDown="Field_MouseDown" MouseMove="Field_MouseMove" MouseLeftButtonUp="Drag_MouseUp">
                        <Border x:Name="HueLayer" CornerRadius="8" Background="Red" />
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas>
                            <Ellipse x:Name="FieldHandle" Style="{StaticResource Handle}" Fill="{Binding SolidBrush, ElementName=Root}" />
                        </Canvas>
                    </Grid>

                    <!-- Hue -->
                    <Grid x:Name="HueBar" Height="16" Margin="0,12,0,0" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Drag_MouseUp">
                        <Border Height="8" CornerRadius="4" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas>
                            <Ellipse x:Name="HueHandle" Style="{StaticResource Handle}" Fill="{Binding Background, ElementName=HueLayer}" />
                        </Canvas>
                    </Grid>

                    <!-- Opacity -->
                    <Grid x:Name="AlphaBar" Height="16" Margin="0,8,0,0" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonDown="Alpha_MouseDown" MouseMove="Alpha_MouseMove" MouseLeftButtonUp="Drag_MouseUp">
                        <Border Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{StaticResource Checkers}" />
                        <Border x:Name="AlphaLayer" Height="8" CornerRadius="4" VerticalAlignment="Center" />
                        <Canvas>
                            <Ellipse x:Name="AlphaHandle" Style="{StaticResource Handle}" Fill="{Binding SwatchBrush, ElementName=Root}" />
                        </Canvas>
                    </Grid>

                    <!-- Red, green, blue (0 to 255) and opacity (0 to 1) -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RedBox" Style="{StaticResource ChannelBox}" AutomationProperties.Name="Red" ToolTip="Red, 0 to 255" />
                        <TextBox x:Name="GreenBox" Grid.Column="2" Style="{StaticResource ChannelBox}" AutomationProperties.Name="Green" ToolTip="Green, 0 to 255" />
                        <TextBox x:Name="BlueBox" Grid.Column="4" Style="{StaticResource ChannelBox}" AutomationProperties.Name="Blue" ToolTip="Blue, 0 to 255" />
                        <TextBox x:Name="AlphaBox" Grid.Column="6" Style="{StaticResource ChannelBox}" AutomationProperties.Name="Opacity" ToolTip="Opacity, 0 (invisible) to 1 (solid)" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
