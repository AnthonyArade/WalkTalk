                        <GeometryDrawing Brush="White" Geometry="M28.1 41.2C28.5988 41.2 29 41.6012 29 42.1V44.8H30.8C30.8 44.1362 31.3363 43.6 32 43.6C32.6638 43.6 33.2 44.1362 33.2 44.8H34.4C34.4 44.1362 34.9363 43.6 35.6 43.6C36.2638 43.6 36.8 44.1362 36.8 44.8H37.4C38.3938 44.8 39.2 45.6062 39.2 46.6V52.6337C39.2 53.005 39.1138 53.3725 38.945 53.7062L38.1875 55.2212C38.0638 55.4725 37.9963 55.7462 37.9963 56.0275V59.2037C37.9963 60.5275 36.92 61.6037 35.5963 61.6037L28.4 61.6C27.0763 61.6 26 60.5237 26 59.2V56.0237C26 55.7425 25.9363 55.4687 25.8088 55.2175L25.055 53.7062C24.8863 53.3725 24.8 53.005 24.8 52.6337V46.6C24.8 45.6062 25.6063 44.8 26.6 44.8H27.2V42.1C27.2 41.6012 27.6013 41.2 28.1 41.2ZM29.3 47.8C28.8013 47.8 28.4 48.2012 28.4 48.7C28.4 49.1987 28.8013 49.6 29.3 49.6H34.7C35.1988 49.6 35.6 49.1987 35.6 48.7C35.6 48.2012 35.1988 47.8 34.7 47.8H29.3ZM29.3 51.4C28.8013 51.4 28.4 51.8012 28.4 52.3C28.4 52.7987 28.8013 53.2 29.3 53.2H34.7C35.1988 53.2 35.6 52.7987 35.6 52.3C35.6 51.8012 35.1988 51.4 34.7 51.4H29.3Z" />
                        <GeometryDrawing Brush="White" Geometry="M8.48752 31.04C8.47168 30.56 8.33392 30.2091 8.10064 29.9811C7.87264 29.7348 7.55488 29.5563 7.15216 29.5563C5.77408 29.5563 5.54656 30.9574 5.54656 32.0518C5.54656 33.4424 6.07648 34.3476 7.15216 34.3476C8.10064 34.3476 8.47168 33.9195 8.57728 32.9595H12.2814C11.9637 35.8395 9.70624 36.8004 7.15216 36.8004C4.17376 36.8004 1.87936 35.1252 1.87936 32.0067C1.87936 28.8512 4.09936 27.1438 7.15216 27.1438C9.616 27.1438 11.9478 28.16 12.2075 31.04H8.48752ZM20.2461 31.04C20.2302 30.56 20.0872 30.2091 19.8592 29.9811C19.6312 29.7348 19.3134 29.5563 18.905 29.5563C17.5331 29.5563 17.3051 30.9574 17.3051 32.0518C17.3051 33.4424 17.835 34.3476 18.905 34.3476C19.8592 34.3476 20.2302 33.9195 20.3358 32.9595H24.04C23.7222 35.8395 21.4648 36.8004 18.905 36.8004C15.927 36.8004 13.6379 35.1252 13.6379 32.0067C13.6379 28.8512 15.8584 27.1438 18.905 27.1438C21.375 27.1438 23.7006 28.16 23.9661 31.04H20.2461Z" />
                        <GeometryDrawing Geometry="M52 24V40M48 29V35M60 30V34M44 30V34M56 27V37">
                            <GeometryDrawing.Pen>
                                <Pen Brush="White" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                        <GeometryDrawing Geometry="M18.094 8.85645C14.3051 11.133 11.1331 14.305 8.85648 18.0939M11.5328 16.5521L8.85648 18.0939L8.96133 15.007M8.85648 45.906C11.1331 49.6949 14.3051 52.8669 18.094 55.1435M16.5522 52.4671L18.094 55.1435L15.0071 55.0386M45.906 55.1435C49.6949 52.8669 52.8669 49.6949 55.1435 45.906M52.4672 47.4478L55.1435 45.906L55.0387 48.9929M55.1435 18.0939C52.8669 14.305 49.6949 11.133 45.906 8.85645M47.4478 11.5328L45.906 8.85645L48.9929 8.9613">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#FFD83995" Thickness="1.15" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- Type: Segoe UI Variable's optical sizes, each tuned for its size range -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Small captions above the toolbar's controls (they sit on the chrome) -->
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource ChromeMutedBrush}" />
                <Setter Property="Margin" Value="2,0,0,4" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>

            <!--
              Shared button anatomy: the face reacts on mouse-down (scale 0.97 + dim) the instant it is
              pressed, not on release, and springs back. Hover is a quiet background change.
            -->
            <ControlTemplate x:Key="PressableButton" TargetType="Button">
                <!-- Tag carries the corner radius ("16" = capsule); a Binding converts it, TemplateBinding wouldn't. -->
                <Border x:Name="Root" Background="{TemplateBinding Background}"
                        CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                        Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Root" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Filled: the one main action on screen (Start / Stop) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,7" />
                <Setter Property="Tag" Value="16" /> <!-- corner radius: capsule -->
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template" Value="{StaticResource PressableButton}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tinted: secondary actions that still deserve presence (Add field) -->
            <Style x:Key="TintedButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Tag" Value="10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template" Value="{StaticResource PressableButton}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentTintHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The same two buttons when they sit on the chrome (toolbar, sidebar): white on sky blue in Light -->
            <Style x:Key="ChromePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="{DynamicResource ChromePrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ChromePrimaryTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ChromePrimaryHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChromeTintedButton" TargetType="Button" BasedOn="{StaticResource TintedButton}">
                <Setter Property="Background" Value="{DynamicResource ChromeTintBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ChromeTintTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ChromeTintHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Plain: inline actions (Copy all, Clear, Test, Cancel, Undo) -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Tag" Value="7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template" Value="{StaticResource PressableButton}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Neutral control-height button, sits alongside the toolbar's dropdowns -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ChromeButtonBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ChromeButtonTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Tag" Value="6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template" Value="{StaticResource PressableButton}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ChromeButtonHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A small on/off capsule for options of a card (Auto-Enter) -->
            <Style x:Key="ChipToggle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Root" CornerRadius="10" Padding="8,3,9,3" Background="{DynamicResource CardBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ToggleOnTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Icon-only destructive action: quiet until hovered -->
            <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
                <Setter Property="Padding" Value="7,5" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- On/off switch: green track, white knob that springs across -->
            <Style x:Key="SwitchStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="38" Height="22" Background="Transparent">
                                <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource SwitchOffBrush}" />
                                <Ellipse x:Name="Knob" Width="18" Height="18" Margin="2,0" HorizontalAlignment="Left" Fill="White">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobX" X="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchOnBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction>
                                                        <motion:SpringEase />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction>
                                                        <motion:SpringEase />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Knob" Property="Width" Value="22" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slider: sky-blue filled part, quiet track, white knob (the theme's own slider ignores the brand color). -->
            <Style x:Key="SliderEdge" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BrandSlider" TargetType="Slider">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Track x:Name="PART_Track" Height="22">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEdge}" Background="{DynamicResource AccentBrush}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEdge}" Background="{DynamicResource SliderTrackBrush}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="19" />
                                                        <Setter TargetName="Knob" Property="Height" Value="19" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Looks like a title until hovered or clicked, then edits in place. -->
            <Style x:Key="NameTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                                    BorderBrush="Transparent" BorderThickness="1" Padding="4,2">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource InsetBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource InsetBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
