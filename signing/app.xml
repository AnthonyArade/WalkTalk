<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the published app folder (publish\app), which the build uploads
     as a zip with the files at its root. Signs WalkTalk's own files; the other files (.NET, Whisper, the
     Microsoft runtime) are not WalkTalk's and stay as their makers shipped them. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="WalkTalk" product-version="${version}">
      <include path="WalkTalk.exe" />
      <include path="WalkTalk.dll" />
      <include path="WhisperStt.Core.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
