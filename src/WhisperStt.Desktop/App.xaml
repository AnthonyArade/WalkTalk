<Application x:Class="WhisperStt.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:WhisperStt.Desktop.Motion"
             ThemeMode="Dark"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
              Colors live in Themes/Dark.xaml and Themes/Light.xaml; ThemeManager swaps the merged
              dictionary at runtime, so every color below and in the windows is used via DynamicResource.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

