<Window x:Class="WhisperStt.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WhisperStt.Desktop.ViewModels"
        xmlns:local="clr-namespace:WhisperStt.Desktop"
        xmlns:motion="clr-namespace:WhisperStt.Desktop.Motion"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WalkTalk" Icon="Assets/WalkTalk.ico" Width="1200" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource TextFont}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseVisibility" />
        <local:EqualsToVisibilityConverter x:Key="VisibleWhen" />
        <local:EqualsToVisibilityConverter x:Key="VisibleUnless" Invert="True" />
        <local:ColorTextToBrushConverter x:Key="ColorBrush" />

        <!-- A row of the OBS dialog: a label, a slider and its value -->
        <Style x:Key="ObsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="ObsValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="ObsSlider" TargetType="Slider" BasedOn="{StaticResource BrandSlider}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,10,8,0" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style x:Key="ObsSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- New items arrive: fade in while rising a few pixels on a critically damped spring. -->
        <Storyboard x:Key="EnterFromBelow">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <motion:SpringEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Panels that appear in place materialize: fade and grow slightly into position. -->
        <Storyboard x:Key="Materialize">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.96" To="1" Duration="0:0:0.36">
                <DoubleAnimation.EasingFunction>
                    <motion:SpringEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.96" To="1" Duration="0:0:0.36">
                <DoubleAnimation.EasingFunction>
                    <motion:SpringEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- The frame every dialog shares: surface, outline, shadow, and the way it appears. Each dialog still
             declares its own ScaleTransform: one set by a style is shared and frozen, so it could not be animated. -->
        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22,18,22,18" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.5" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource Materialize}" />
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar, on the chrome (Mica in Dark, sky blue in Light) -->
        <DockPanel Grid.Row="0" Margin="20,14,20,14" LastChildFill="False" TextElement.Foreground="{DynamicResource ChromeTextBrush}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource LogoImage}" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WalkTalk" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Offline speech-to-text" FontFamily="{StaticResource SmallFont}" FontSize="12" Foreground="{DynamicResource ChromeMutedBrush}" />
                </StackPanel>
                <!-- Light / dark theme switch: shows the theme it switches to (sun = light, moon = dark) -->
                <Button Style="{StaticResource GhostButton}" Margin="14,0,0,0" Padding="9,7" VerticalAlignment="Center"
                        Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToggleText}"
                        AutomationProperties.Name="{Binding ThemeToggleText}">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource ChromeMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE706;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                        <Setter Property="Text" Value="&#xE708;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <!-- OBS overlay: shows the transcript on stream; the dot lights up while the canvas is on -->
                <Button Style="{StaticResource GhostButton}" Margin="2,0,0,0" Padding="9,7" VerticalAlignment="Center"
                        Command="{Binding Obs.OpenCommand}" ToolTip="OBS overlay: show the transcript on your stream"
                        AutomationProperties.Name="OBS overlay settings">
                    <StackPanel Orientation="Horizontal">
                        <!-- The OBS Studio logo -->
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="75" Height="75">
                                <Ellipse Canvas.Left="1.7" Canvas.Top="1.7" Width="71.6" Height="71.6" Fill="#302E31" Stroke="White" StrokeThickness="3.47" />
                                <Path Fill="#C4C2C4" Data="M 19.3 18.7 c 1.1 -5.31 4.7 -10.1 9.54 -12.5 -0.842 0.855 -1.86 1.51 -2.64 2.44 -3.19 3.44 -4.63 8.42 -3.75 13 1.11 6.99 7.68 12.7 14.8 12.6 5.52 0.247 10.9 -2.93 13.6 -7.72 5.78 0.196 11.4 3.18 14.7 7.97 1.69 2.5 3.01 5.43 3.1 8.48 -1.07 -4.05 -3.76 -7.65 -7.43 -9.68 -3.55 -2 -7.91 -2.51 -11.8 -1.33 -4.88 1.4 -8.91 5.39 -10.3 10.3 -1.18 3.91 -0.675 8.22 1.18 11.8 -2.58 4.47 -7.24 7.66 -12.3 8.62 -3.89 0.816 -7.98 0.186 -11.6 -1.45 3.24 0.945 6.76 1.11 9.98 -0.035 4.32 -1.43 7.89 -4.9 9.46 -9.18 1.74 -4.66 1.08 -10.2 -1.85 -14.2 -2.19 -3.15 -5.64 -5.37 -9.39 -6.16 -1.19 -0.212 -2.39 -0.308 -3.59 -0.418 -1.91 -3.85 -2.61 -8.32 -1.65 -12.5 z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="OBS" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource ChromeMutedBrush}" />
                        <Ellipse Width="7" Height="7" Margin="6,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource HighlightBrush}"
                                 Visibility="{Binding Obs.IsOn, Converter={StaticResource Visibility}}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Microphone" Style="{StaticResource LabelText}" />
                    <ComboBox Width="190" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                              IsEnabled="{Binding CanChangeSettings}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Model" Style="{StaticResource LabelText}" />
                    <ComboBox Width="110" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                              IsEnabled="{Binding CanChangeSettings}"
                              ToolTip="turbo is recommended: very accurate and fast on a graphics card. Each model downloads once." />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Language" Style="{StaticResource LabelText}" />
                    <ComboBox Width="130" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Name" IsEnabled="{Binding CanChangeSettings}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Word hints" Style="{StaticResource LabelText}" />
                    <Button Style="{StaticResource SecondaryButton}" MinWidth="110" Command="{Binding OpenHintsCommand}"
                            AutomationProperties.Name="Word hints"
                            ToolTip="Names and words Whisper should spell correctly">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ChromeButtonIconBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding HintsSummary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="TTS" Style="{StaticResource LabelText}" />
                    <Button Style="{StaticResource SecondaryButton}" MinWidth="100" Command="{Binding ReadAloud.OpenCommand}"
                            AutomationProperties.Name="TTS settings"
                            ToolTip="Read each sentence aloud with a Kokoro voice">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ChromeButtonIconBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReadAloud.IsEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource HighlightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ReadAloud.Summary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button MinWidth="150" VerticalAlignment="Bottom" Command="{Binding ToggleListeningCommand}"
                        Content="{Binding StartButtonText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChromePrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsListening}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: text fields in other apps, on the chrome -->
            <DockPanel Grid.Column="0" Margin="16,4,16,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Fields" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource ChromeTextBrush}" />
                    <TextBlock Text="Text boxes in other apps. Each sentence you say is written into every field that is switched on."
                               FontFamily="{StaticResource SmallFont}" FontSize="12" Foreground="{DynamicResource ChromeMutedBrush}"
                               TextWrapping="Wrap" Margin="0,3,0,14" />

                    <Button Style="{StaticResource ChromeTintedButton}" Command="{Binding AddTargetCommand}" Margin="0,0,0,14"
                            AutomationProperties.Name="Add field"
                            Visibility="{Binding IsPicking, Converter={StaticResource InverseVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Add field" />
                        </StackPanel>
                    </Button>

                    <!-- Shown while waiting for the click in another app; materializes where the Add button was -->
                    <Border Background="{DynamicResource PickBannerBrush}" BorderBrush="{DynamicResource PickBannerStrokeBrush}" BorderThickness="1.5"
                            CornerRadius="12" Padding="14,12" Margin="0,0,0,14" RenderTransformOrigin="0.5,0"
                            TextElement.Foreground="{DynamicResource TextBrush}">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource Materialize}" />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{DynamicResource PulseBrush}"
                                     VerticalAlignment="Top" Margin="0,5,10,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.7" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,-6,-4"
                                    Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelPickCommand}" />
                            <TextBlock Text="{Binding PickMessage}" TextWrapping="Wrap" FontSize="13" />
                        </DockPanel>
                    </Border>

                    <!-- Built-in destination: VRChat's chatbox, reached over OSC on a fixed local port (nothing to pick) -->
                    <Border x:Name="VrChatCard" CornerRadius="12" Padding="10,8,8,10" Margin="0,0,0,8" DataContext="{Binding VrChat}"
                            TextElement.Foreground="{DynamicResource TextBrush}"
                            ToolTip="Needs OSC switched on in VRChat: Action Menu, Options, OSC, Enabled">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SidebarCardBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarCardHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" Margin="8,0,4,0"
                                          AutomationProperties.Name="Send sentences to VRChat"
                                          IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                                          ToolTip="When on, each new sentence is shown in your VRChat chatbox" />
                                <TextBlock Text="VRChat" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource SmallFont}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" Margin="5,1,0,0" TextTrimming="CharacterEllipsis" />
                            <DockPanel Margin="5,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test" Margin="2,-4,0,-4"
                                        Command="{Binding TestCommand}" ToolTip="Show a test sentence in your VRChat chatbox"
                                        AutomationProperties.Name="Test VRChat" />
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Sent">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Built-in destination: Twitch chat, after the user has connected their account (OAuth 2) -->
                    <Border x:Name="TwitchCard" CornerRadius="12" Padding="10,8,8,10" Margin="0,0,0,8" DataContext="{Binding Twitch}"
                            TextElement.Foreground="{DynamicResource TextBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SidebarCardBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarCardHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" Margin="8,0,4,0"
                                          AutomationProperties.Name="Send sentences to Twitch chat"
                                          IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                                          ToolTip="When on, each new sentence is posted in the Twitch chat"
                                          Visibility="{Binding State, Converter={StaticResource VisibleWhen}, ConverterParameter=Connected}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Connect" Margin="0,-4,0,-4" FontWeight="SemiBold"
                                        Command="{Binding ConnectCommand}" AutomationProperties.Name="Connect Twitch"
                                        ToolTip="Sign in on twitch.tv in your browser and allow WalkTalk to write chat messages"
                                        Visibility="{Binding State, Converter={StaticResource VisibleWhen}, ConverterParameter=Disconnected}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,-4,0,-4"
                                        Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel Twitch sign-in"
                                        Visibility="{Binding State, Converter={StaticResource VisibleWhen}, ConverterParameter=Connecting}" />
                                <TextBlock Text="Twitch" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource SmallFont}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedBrush}" Margin="5,1,0,0" />

                            <!-- Waiting for the approval in the browser -->
                            <DockPanel Margin="5,8,0,0" Visibility="{Binding State, Converter={StaticResource VisibleWhen}, ConverterParameter=Connecting}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open page" Margin="2,-4,0,-4"
                                        Command="{Binding OpenPageCommand}" ToolTip="Open the Twitch approval page again" />
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <Run Text="Code" Foreground="{DynamicResource MutedBrush}" />
                                    <Run Text="{Binding UserCode, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                </TextBlock>
                            </DockPanel>

                            <!-- Connected: which channel to write in -->
                            <DockPanel Margin="5,8,2,0" Visibility="{Binding State, Converter={StaticResource VisibleWhen}, ConverterParameter=Connected}"
                                       ToolTip="The channel whose chat you write in, as in twitch.tv/name. Leave empty for your own channel.">
                                <TextBlock DockPanel.Dock="Left" Text="Channel" FontFamily="{StaticResource SmallFont}" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Grid>
                                    <TextBox x:Name="TwitchChannelBox" Text="{Binding Channel, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                             VerticalContentAlignment="Center" AutomationProperties.Name="Twitch channel" KeyDown="NameBox_KeyDown" />
                                    <TextBlock Text="{Binding ChannelHint}" IsHitTestVisible="False" Margin="12,0,0,0" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=TwitchChannelBox, Converter={StaticResource VisibleWhen}, ConverterParameter=''}" />
                                </Grid>
                            </DockPanel>

                            <DockPanel Margin="5,8,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            Visibility="{Binding State, Converter={StaticResource VisibleWhen}, ConverterParameter=Connected}">
                                    <Button Style="{StaticResource GhostButton}" Content="Disconnect" Margin="2,-4,0,-4"
                                            Command="{Binding DisconnectCommand}" ToolTip="Sign out of Twitch on this PC"
                                            AutomationProperties.Name="Disconnect Twitch" />
                                    <Button Style="{StaticResource GhostButton}" Content="Test" Margin="2,-4,0,-4"
                                            Command="{Binding TestCommand}" ToolTip="Post a test message in the chat"
                                            AutomationProperties.Name="Test Twitch" />
                                </StackPanel>
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Sent">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Undo after deleting a field: forgiveness instead of a confirmation dialog -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToastBrush}" CornerRadius="12" Padding="14,6,6,6" Margin="0,8,0,16"
                        RenderTransformOrigin="0.5,1" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Border.RenderTransform>
                        <ScaleTransform />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUndo}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource Materialize}" />
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Undo" FontWeight="SemiBold"
                                Command="{Binding UndoRemoveCommand}" />
                        <TextBlock Text="{Binding UndoText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <Grid>
                    <TextBlock Foreground="{DynamicResource ChromeMutedBrush}" FontFamily="{StaticResource SmallFont}" FontSize="12"
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="12,24,12,0"
                               Text="No fields of your own yet. Click Add field, then click a text box in any app: Notepad, your browser, a chat window…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Targets.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TargetList" ItemsSource="{Binding Targets}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TargetViewModel}">
                                    <Border x:Name="Card" CornerRadius="12" Padding="10,8,8,10" Margin="0,0,0,8"
                                            TextElement.Foreground="{DynamicResource TextBrush}">
                                        <Border.RenderTransform>
                                            <TranslateTransform />
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource EnterFromBelow}" />
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SidebarCardBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SidebarCardHoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="NameBox" Style="{StaticResource NameTextBox}" VerticalAlignment="Center"
                                                         Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="NameBox_KeyDown" ToolTip="Click to rename" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="8,0,4,0"
                                                          AutomationProperties.Name="Send sentences to this field"
                                                          IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                                                          ToolTip="When on, each new sentence is written into this field" />
                                                <Button Grid.Column="2" Style="{StaticResource DeleteButton}"
                                                        Command="{Binding RemoveCommand}" ToolTip="Delete field"
                                                        AutomationProperties.Name="Delete field">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </Button>
                                            </Grid>

                                            <TextBlock x:Name="Detail" Text="{Binding Detail}" FontFamily="{StaticResource SmallFont}" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="5,1,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Info.WindowTitle}" />

                                            <DockPanel x:Name="StatusRow" Margin="5,8,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test" Margin="2,-4,0,-4"
                                                        Command="{Binding TestCommand}" ToolTip="Write a test sentence into this field" />
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ChipToggle}" IsChecked="{Binding PressEnter}"
                                                          VerticalAlignment="Center" Margin="6,0,0,0"
                                                          AutomationProperties.Name="Press Enter after each sentence"
                                                          ToolTip="Press Enter after each sentence: sends the message in chat apps like Twitch or Discord">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE751;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   VerticalAlignment="Center" Margin="0,1,5,0" />
                                                        <TextBlock Text="Auto-Enter" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </CheckBox>
                                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource TertiaryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Off: the content recedes, the switch stays fully visible -->
                                        <DataTrigger Binding="{Binding IsOn}" Value="False">
                                            <Setter TargetName="NameBox" Property="Opacity" Value="0.5" />
                                            <Setter TargetName="Detail" Property="Opacity" Value="0.5" />
                                            <Setter TargetName="StatusRow" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Sent">
                                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Content well: solid surface so the transcript stays crisp over the translucent window -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,0,0,0" Padding="26,18,26,10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Live transcript" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="11" Padding="10,3,11,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SpeakingBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReadAloud.IsReading}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource HighlightBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StateText}" FontFamily="{StaticResource SmallFont}" FontSize="12"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Microphone level: a capsule meter that rises instantly and falls gently -->
                        <Grid Grid.Column="1" Width="120" Height="4" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                              ToolTip="Microphone level">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="2" />
                            <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Level}" />
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SpeakingBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,-8,0">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding VoiceTraining.OpenCommand}"
                                    AutomationProperties.Name="Voice training"
                                    ToolTip="Read sentences aloud so WalkTalk can retrain its speech model on your voice and accent. Stop listening first.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="Voice training" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding Replacements.OpenCommand}"
                                    AutomationProperties.Name="Word replacements"
                                    ToolTip="Write an abbreviation or slang in place of a word or phrase you say">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="Replacements" />
                                    <TextBlock Text="{Binding Replacements.Summary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Copy all" Command="{Binding CopyTranscriptCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearTranscriptCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Sentences waiting to be learned by the voice model: corrections made with Review end up here -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AccentTintBrush}" CornerRadius="10" Padding="14,6,6,6" Margin="0,0,0,12"
                            Visibility="{Binding VoiceTraining.HasPending, Converter={StaticResource Visibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="14,6" Margin="12,0,0,0"
                                    Content="{Binding VoiceTraining.LearnText}" Command="{Binding VoiceTraining.LearnCommand}"
                                    AutomationProperties.Name="Teach my voice model"
                                    ToolTip="A short training that adds these sentences to your voice model. Stop listening first." />
                            <TextBlock Text="{Binding VoiceTraining.PendingText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentHoverBrush}" />
                        </DockPanel>
                    </Border>

                    <!-- Status line at the foot of the content -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,8,0,0"
                               FontFamily="{StaticResource SmallFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Transcript.Count}" Value="0" />
                                                <Condition Binding="{Binding PendingText}" Value="" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Nothing said yet" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Press Start listening and speak. Each sentence appears here when you pause."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="0,6,0,6">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Transcript}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TranscriptLine}">
                                            <Grid Margin="0,0,0,18">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform />
                                                </Grid.RenderTransform>
                                                <Grid.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard Storyboard="{StaticResource EnterFromBelow}" />
                                                    </EventTrigger>
                                                </Grid.Triggers>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource SmallFont}" FontSize="12"
                                                           Typography.NumeralAlignment="Tabular"
                                                           Foreground="{DynamicResource TertiaryBrush}" Margin="0,5,0,0" />
                                                <!-- Review: only on the latest sentences heard with the voice model, whose audio is still kept -->
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="10,0,10,0"
                                                        Command="{Binding ReviewCommand}" AutomationProperties.Name="Review this sentence"
                                                        ToolTip="Written wrong? Correct it, and your voice model learns from this sentence."
                                                        Visibility="{Binding CanReview, Converter={StaticResource Visibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" />
                                                        <TextBlock Text="Review" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="LineText" Text="{Binding Text}" FontSize="17" TextWrapping="Wrap" LineHeight="25" />
                                                    <!-- The sentence as an editable text, while it is being reviewed -->
                                                    <StackPanel x:Name="ReviewEditor" Visibility="Collapsed">
                                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" TextWrapping="Wrap"
                                                                 Padding="10,7" IsVisibleChanged="ReviewBox_IsVisibleChanged"
                                                                 AutomationProperties.Name="Corrected sentence">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Command="{Binding SaveReviewCommand}" />
                                                                <KeyBinding Key="Escape" Command="{Binding CancelReviewCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <DockPanel Margin="0,7,0,0">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                                                <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelReviewCommand}" />
                                                                <Button Style="{StaticResource TintedButton}" Content="Save" FontSize="12" Padding="14,5" Margin="4,0,0,0"
                                                                        Command="{Binding SaveReviewCommand}" AutomationProperties.Name="Save the correction" />
                                                            </StackPanel>
                                                            <TextBlock x:Name="ReviewNote" Text="{Binding ReviewNote}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                    <TextBlock x:Name="CorrectedNote" Text="Corrected · saved for your voice model" FontFamily="{StaticResource SmallFont}"
                                                               FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource AccentHoverBrush}" Visibility="Collapsed" />
                                                    <StackPanel x:Name="CommandLine" Orientation="Horizontal" Visibility="Collapsed">
                                                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentHoverBrush}" Margin="0,2,8,0" />
                                                        <TextBlock Text="{Binding CommandText}" FontSize="15" FontStyle="Italic" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentHoverBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="NoTargets" Text="Not sent to any field" FontFamily="{StaticResource SmallFont}"
                                                               FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TertiaryBrush}" Visibility="Collapsed" />
                                                    <ItemsControl ItemsSource="{Binding Deliveries}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DeliveryViewModel}">
                                                                <Border x:Name="Chip" CornerRadius="10" Padding="9,2,9,3" Margin="0,0,6,4"
                                                                        Background="{DynamicResource CardBrush}" ToolTip="{Binding Error}">
                                                                    <TextBlock x:Name="ChipText" Text="{Binding Label}" FontFamily="{StaticResource SmallFont}"
                                                                               FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="Sent">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerTintBrush}" />
                                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasDeliveries}" Value="False">
                                                    <Setter TargetName="NoTargets" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                    <Setter TargetName="LineText" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="CommandLine" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCorrected}" Value="True">
                                                    <Setter TargetName="CorrectedNote" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsReviewing}" Value="True">
                                                    <Setter TargetName="LineText" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="CorrectedNote" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ReviewEditor" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReviewProblem}" Value="True">
                                                    <Setter TargetName="ReviewNote" Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding PendingText}" Margin="72,0,0,0" FontSize="15" FontStyle="Italic"
                                           Foreground="{DynamicResource MutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PendingText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Word replacements: search a word the model knows (or type any word or phrase) and give the text to
             write instead. Same modal pattern as the word hints. -->
        <Grid x:Name="ReplacementsOverlay" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
              Visibility="{Binding Replacements.IsOpen, Converter={StaticResource Visibility}}">
            <Border Width="520" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource DialogCard}">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
                <DockPanel DataContext="{Binding Replacements}">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}" Command="{Binding CloseCommand}"
                                AutomationProperties.Name="Close" ToolTip="Close" Margin="0,-4,-8,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <TextBlock Text="Word replacements" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4,0,14" FontFamily="{StaticResource SmallFont}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="When WalkTalk hears a word or phrase, it writes yours instead: an abbreviation, slang, an emoji. Search a word the model knows, then type what to write. It applies from the next sentence you say." />

                    <!-- Hear this → write that -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplacementSearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="Search a word the model knows">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" IsHitTestVisible="False" Margin="11,1,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TertiaryBrush}" />
                        <TextBlock Text="Search a word, or type a phrase" IsHitTestVisible="False" Margin="32,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}"
                                   Visibility="{Binding Text, ElementName=ReplacementSearchBox, Converter={StaticResource VisibleWhen}, ConverterParameter=''}" />
                        <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="8,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <TextBox x:Name="ReplacementCustomBox" Grid.Column="2" Text="{Binding Custom, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="Write this instead">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Grid.Column="2" Text="Write this instead" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}"
                                   Visibility="{Binding Text, ElementName=ReplacementCustomBox, Converter={StaticResource VisibleWhen}, ConverterParameter=''}" />
                        <Button Grid.Column="3" Style="{StaticResource TintedButton}" Content="Add" Margin="8,0,0,0"
                                Command="{Binding AddCommand}" AutomationProperties.Name="Add replacement" />
                    </Grid>

                    <!-- Words from the model's list that match what is typed; a click takes one -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Suggestions}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Cursor="Hand" Margin="0,0,6,6" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                        Command="{Binding DataContext.Replacements.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="Use this word">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip" CornerRadius="13" Padding="11,4" Background="{DynamicResource CardBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Note}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="2,2,0,0"
                               Visibility="{Binding Note, Converter={StaticResource VisibleUnless}, ConverterParameter=''}" />

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Right"
                            MinWidth="96" Margin="0,14,0,0" Command="{Binding CloseCommand}" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="No replacements yet." HorizontalAlignment="Center" Margin="0,18" FontSize="13"
                                   Foreground="{DynamicResource TertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,4,4,4" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}"
                                                        Command="{Binding DataContext.Replacements.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove replacement">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                                </Button>
                                                <TextBlock FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding From, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                                    <Run Text="  →  " Foreground="{DynamicResource TertiaryBrush}" />
                                                    <Run Text="{Binding To, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Word hints dialog: a modal task, so the window dims behind it. Esc, Done or a click outside closes it. -->
        <Grid x:Name="HintsOverlay" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
              Visibility="{Binding IsHintsOpen, Converter={StaticResource Visibility}}">
            <Border x:Name="HintsDialog" Width="440" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource DialogCard}">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}" Command="{Binding CloseHintsCommand}"
                                AutomationProperties.Name="Close" ToolTip="Close" Margin="0,-4,-8,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <TextBlock Text="Word hints" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4,0,14" FontFamily="{StaticResource SmallFont}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Names and words Whisper should spell exactly: usernames, games, jargon. Close matches in the transcript are corrected to your spelling. Changes apply the next time you press Start listening." />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewHintBox" Text="{Binding NewHint, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="New word hint">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddHintCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Add a word or name" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewHintBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Style="{StaticResource TintedButton}" Content="Add" Margin="8,0,0,0"
                                Command="{Binding AddHintCommand}" />
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Right"
                            MinWidth="96" Margin="0,14,0,0" Command="{Binding CloseHintsCommand}" />

                    <Grid>
                        <TextBlock Text="No words yet." HorizontalAlignment="Center" Margin="0,18" FontSize="13"
                                   Foreground="{DynamicResource TertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WordHintList.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding WordHintList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,4,4,4" Margin="0,0,0,6">
                                            <Border.RenderTransform>
                                                <TranslateTransform />
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource EnterFromBelow}" />
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}"
                                                        Command="{Binding DataContext.RemoveHintCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove word hint">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                                </Button>
                                                <TextBlock Text="{Binding}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Voice training: read sentences, retrain the model on them, compare before and after. Closes only
             with its own buttons or Esc (a stray click outside would stop a recording or a training run). -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding VoiceTraining.IsOpen, Converter={StaticResource Visibility}}">
            <Border Width="600" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource DialogCard}">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
                <DockPanel DataContext="{Binding VoiceTraining}">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}" Command="{Binding CloseCommand}"
                                AutomationProperties.Name="Close" ToolTip="Close" Margin="0,-4,-8,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <TextBlock Text="Voice training" Style="{StaticResource SectionTitle}" />
                    </DockPanel>

                    <Grid>
                        <!-- Step 1: where things stand -->
                        <DockPanel Visibility="{Binding Step, Converter={StaticResource VisibleWhen}, ConverterParameter=Intro}">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4,0,14" FontFamily="{StaticResource SmallFont}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Text="Read sentences aloud and WalkTalk retrains its speech model on your recordings, so it gets used to your accent and the way you pronounce words. Everything stays on this PC. The trained model is only used if it scores better and you accept it." />

                            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding TrainText}" MinWidth="170"
                                        Command="{Binding TrainCommand}" AutomationProperties.Name="Train my voice model" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Retrain everything" Margin="0,0,6,0"
                                        Command="{Binding RetrainCommand}" ToolTip="Train the standard model again on all your recordings (takes longer)"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource Visibility}}" />
                                <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding TrainHint}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding IntroMessage, Converter={StaticResource VisibleWhen}, ConverterParameter=''}" />
                                    <TextBlock Text="{Binding IntroMessage}" FontSize="12" Foreground="{DynamicResource DangerHoverBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10">
                                        <DockPanel>
                                            <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                                                      DisplayMemberPath="Name" VerticalAlignment="Center" AutomationProperties.Name="Language of the sentences" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Language you dictate in" FontSize="13" />
                                                <TextBlock Text="The sentences to read are in this language." FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- How much of the sentence list to read and train on, with the training time for each choice -->
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Sentences to use" FontSize="13" />
                                            <TextBlock Text="{Binding ShareText}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10" />
                                            <ItemsControl ItemsSource="{Binding ShareOptions}" Margin="0,0,-6,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ShareOption}">
                                                        <Button Margin="0,0,6,0" AutomationProperties.Name="{Binding Description}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.VoiceTraining.SelectShareCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                    <Setter Property="Padding" Value="4,7,4,8" />
                                                                    <Setter Property="Tag" Value="9" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                                           HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding ShareNote}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                       Foreground="{DynamicResource TertiaryBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Your recordings" FontSize="13" />
                                            <TextBlock Text="{Binding RecordedText}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,8" />
                                            <Grid Height="5" Margin="0,0,0,10">
                                                <Border Background="{DynamicResource DialogBrush}" CornerRadius="2.5" />
                                                <Border CornerRadius="2.5" RenderTransformOrigin="0,0.5" Background="{DynamicResource AccentBrush}">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding RecordedFraction}" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource TintedButton}" Content="{Binding RecordText}" Command="{Binding RecordCommand}"
                                                        AutomationProperties.Name="Record sentences" />
                                                <Button Style="{StaticResource GhostButton}" Content="Delete recordings" Margin="6,0,0,0"
                                                        Command="{Binding ClearRecordingsCommand}" ToolTip="Delete every recording in this language and start again"
                                                        Visibility="{Binding HasRecordings, Converter={StaticResource Visibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0"
                                            Visibility="{Binding HasModel, Converter={StaticResource Visibility}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Remove" VerticalAlignment="Center"
                                                    Command="{Binding RemoveModelCommand}" ToolTip="Delete your voice model and go back to the standard one"
                                                    AutomationProperties.Name="Remove voice model" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Your voice model" FontSize="13" />
                                                <TextBlock Text="{Binding ModelText}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Your own sentences (optional)" FontSize="13" />
                                            <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10"
                                                       Text="Add sentences with the names and words you really say, like usernames or game terms. They are read and learned along with the others." />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="NewSentenceBox" Text="{Binding NewSentence, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" AutomationProperties.Name="New sentence">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding AddSentenceCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock Text="A sentence you often say" IsHitTestVisible="False" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}"
                                                           Visibility="{Binding Text, ElementName=NewSentenceBox, Converter={StaticResource VisibleWhen}, ConverterParameter=''}" />
                                                <Button Grid.Column="1" Style="{StaticResource TintedButton}" Content="Add" Margin="8,0,0,0"
                                                        Command="{Binding AddSentenceCommand}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding CustomSentences}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,2">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}" ToolTip="Remove"
                                                                    AutomationProperties.Name="Remove sentence"
                                                                    Command="{Binding DataContext.VoiceTraining.RemoveSentenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                                            </Button>
                                                            <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sentences corrected with Review in the transcript -->
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Sentences you corrected" FontSize="13" />
                                            <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                                       Text="Transcript lines you fixed with Review. Each one is kept with its audio and practised until the model writes it right. For a word that keeps coming out wrong, correct it a few times: each time you say it is a little different, and that is what teaches the model the word." />
                                            <TextBlock Text="None yet. While dictating with your voice model, press Review on a line that was written wrong."
                                                       TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource TertiaryBrush}"
                                                       Visibility="{Binding HasCorrections, Converter={StaticResource InverseVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding Corrections}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasCorrections, Converter={StaticResource Visibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CorrectionItem}">
                                                        <DockPanel Margin="0,0,0,2">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}" ToolTip="Delete this recording"
                                                                    AutomationProperties.Name="Delete corrected sentence"
                                                                    Command="{Binding DataContext.VoiceTraining.RemoveCorrectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                                            </Button>
                                                            <Border x:Name="StatusChip" DockPanel.Dock="Right" CornerRadius="9" Padding="8,1,8,2" Margin="8,0,4,0"
                                                                    VerticalAlignment="Center" Background="{DynamicResource DialogBrush}"
                                                                    ToolTip="Waiting: your voice model has not been trained on it yet">
                                                                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                                           Foreground="{DynamicResource MutedBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Text}" />
                                                        </DockPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Learned}" Value="True">
                                                                <Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                                <Setter TargetName="StatusChip" Property="ToolTip" Value="Learned: your voice model has been trained on it" />
                                                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="2,12,0,0">
                                        <TextBlock Text="{Binding CardText}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CardProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding KitText}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding BaseModelText}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Step 2: read one sentence at a time -->
                        <DockPanel Visibility="{Binding Step, Converter={StaticResource VisibleWhen}, ConverterParameter=Reading}">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PositionText}" Margin="0,4,0,10" FontFamily="{StaticResource SmallFont}"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Stop for now" Command="{Binding StopReadingCommand}"
                                        ToolTip="Go back; the sentences you have read are kept" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Next" MinWidth="110"
                                        Command="{Binding NextCommand}" IsDefault="True" AutomationProperties.Name="Next sentence" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource TintedButton}" Content="Read it again" Margin="0,0,8,0"
                                        Command="{Binding RedoCommand}" ToolTip="Forget this recording and read the sentence again" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <Grid DockPanel.Dock="Left" Width="120" Height="4" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Microphone level">
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="2" />
                                    <Border CornerRadius="2" RenderTransformOrigin="0,0.5" Background="{DynamicResource SpeakingBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Level}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ReadingMessage}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReadingProblem}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24,22" MinHeight="150">
                                <TextBlock Text="{Binding CurrentSentence}" FontFamily="{StaticResource DisplayFont}" FontSize="24" LineHeight="34"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Border>
                        </DockPanel>

                        <!-- Step 3: installing the tools, training, comparing -->
                        <StackPanel VerticalAlignment="Center" Margin="0,40,0,40"
                                    Visibility="{Binding Step, Converter={StaticResource VisibleWhen}, ConverterParameter=Working}">
                            <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <Grid Width="320" Height="6" Margin="0,18,0,0">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" />
                                <Border CornerRadius="3" RenderTransformOrigin="0,0.5" Background="{DynamicResource AccentBrush}">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Progress}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ProgressDetail}" FontFamily="{StaticResource SmallFont}" FontSize="11" Margin="30,14,30,0"
                                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,18,0,0"
                                    Command="{Binding CloseCommand}" />
                        </StackPanel>

                        <!-- Step 4: before and after -->
                        <DockPanel Visibility="{Binding Step, Converter={StaticResource VisibleWhen}, ConverterParameter=Results}">
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Don't use it" Command="{Binding DiscardCommand}"
                                        ToolTip="Throw this trained model away; your recordings are kept" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Use my voice model" MinWidth="160"
                                        Command="{Binding UseCommand}" AutomationProperties.Name="Use my voice model"
                                        Visibility="{Binding CanUse, Converter={StaticResource Visibility}}" />
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding ResultTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Grid Margin="0,12,0,0" Visibility="{Binding HasScores, Converter={StaticResource Visibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding BeforeLabel}" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Text="{Binding BeforeText}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="12,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                        <Border Grid.Column="2" Background="{DynamicResource AccentTintBrush}" CornerRadius="10" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AfterLabel}" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Text="{Binding AfterText}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding ResultDetail}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}" Margin="2,10,0,0" />

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Examples.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="What changed" FontSize="13" FontWeight="SemiBold" Margin="2,16,0,8" />
                                        <ItemsControl ItemsSource="{Binding Examples}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:TrainingExample}">
                                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition />
                                                                <RowDefinition />
                                                                <RowDefinition />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="You read" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource TertiaryBrush}" Margin="0,2,0,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Sentence}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1" Text="Before" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource TertiaryBrush}" Margin="0,4,0,0" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Before}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            <TextBlock Grid.Row="2" Text="After" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource TertiaryBrush}" Margin="0,4,0,0" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding After}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- TTS (text-to-speech) settings: same modal pattern as the word hints -->
        <Grid x:Name="ReadAloudOverlay" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
              Visibility="{Binding ReadAloud.IsOpen, Converter={StaticResource Visibility}}">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource DialogCard}">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}" Command="{Binding CloseDialogsCommand}"
                                AutomationProperties.Name="Close" ToolTip="Close" Margin="0,-4,-8,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <TextBlock Text="TTS" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" FontFamily="{StaticResource SmallFont}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Reads each sentence aloud with a Kokoro voice once it has been written. Runs on this PC. The first time it's turned on, the voice model shared by all voices (334 MB) downloads once; if interrupted, it picks up where it stopped." />

                    <!-- On/off -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" IsChecked="{Binding ReadAloud.IsEnabled}"
                                      VerticalAlignment="Center" AutomationProperties.Name="{Binding ReadAloud.ToggleText}" />
                            <TextBlock Text="{Binding ReadAloud.ToggleText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Voice, speed and volume -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Voice" VerticalAlignment="Center" FontSize="13" />
                            <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ReadAloud.Voices}"
                                      SelectedItem="{Binding ReadAloud.Voice}" DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Voice" />

                            <TextBlock Grid.Row="1" Text="Speed" VerticalAlignment="Center" FontSize="13" Margin="0,12,0,0" />
                            <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource BrandSlider}" Minimum="0.6" Maximum="1.6" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding ReadAloud.Speed}"
                                    VerticalAlignment="Center" Margin="0,12,8,0" AutomationProperties.Name="Speed" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ReadAloud.SpeedText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="13" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource MutedBrush}" />

                            <TextBlock Grid.Row="2" Text="Volume" VerticalAlignment="Center" FontSize="13" Margin="0,12,0,0" />
                            <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource BrandSlider}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding ReadAloud.Volume}"
                                    VerticalAlignment="Center" Margin="0,12,8,0" AutomationProperties.Name="Volume" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ReadAloud.VolumeText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="13" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                    </Border>

                    <!-- Microphone pause -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" IsChecked="{Binding ReadAloud.PauseMic}"
                                      VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Pause the microphone while reading" />
                            <StackPanel>
                                <TextBlock Text="Pause the microphone while reading" FontSize="13" />
                                <TextBlock Text="Stops the app from transcribing its own voice through speakers. Turn off if you use headphones."
                                           TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Done" MinWidth="96"
                                Command="{Binding CloseDialogsCommand}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource TintedButton}" Command="{Binding ReadAloud.PreviewCommand}"
                                AutomationProperties.Name="Preview voice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Preview" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ReadAloud.Status}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,12,0"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OBS overlay: the transcript on a transparent page OBS shows as a Browser Source, styled here with a live preview -->
        <Grid x:Name="ObsOverlay" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
              Visibility="{Binding Obs.IsOpen, Converter={StaticResource Visibility}}">
            <Border Width="1000" Margin="24" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource DialogCard}" DataContext="{Binding Obs}">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DeleteButton}"
                                Command="{Binding DataContext.CloseDialogsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Close" ToolTip="Close" Margin="0,-4,-8,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <TextBlock Text="OBS overlay" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4,0,14" FontFamily="{StaticResource SmallFont}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Shows each sentence on your stream. In OBS, add a Browser Source with the address below and the canvas size, and leave its background transparent." />

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Done" MinWidth="96"
                                Command="{Binding DataContext.CloseDialogsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Reset style" Command="{Binding ResetCommand}"
                                ToolTip="Go back to the default look (the canvas switch and installed fonts stay)" />
                        <TextBlock Text="{Binding Status}" FontFamily="{StaticResource SmallFont}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,12,0" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Settings -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <!-- Canvas switch and address -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsOn}"
                                                      VerticalAlignment="Center" AutomationProperties.Name="Canvas" />
                                            <TextBlock Text="{Binding ToggleText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Margin="0,10,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource TintedButton}" FontSize="12" Padding="12,5"
                                                    Content="Copy" Command="{Binding CopyUrlCommand}" Margin="8,0,0,0"
                                                    AutomationProperties.Name="Copy the overlay address" />
                                            <TextBox Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"
                                                     FontSize="12" AutomationProperties.Name="Overlay address" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Canvas -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="4" Text="Canvas" Style="{StaticResource ObsSection}" />
                                        <TextBlock Grid.Row="1" Text="Size (px)" Style="{StaticResource ObsLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CanvasWidth}" Margin="0,10,0,0" KeyDown="NameBox_KeyDown"
                                                 VerticalContentAlignment="Center" AutomationProperties.Name="Canvas width" ToolTip="Width" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="×" HorizontalAlignment="Center" Style="{StaticResource ObsLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CanvasHeight}" Margin="0,10,0,0" KeyDown="NameBox_KeyDown"
                                                 VerticalContentAlignment="Center" AutomationProperties.Name="Canvas height" ToolTip="Height" />
                                        <TextBlock Grid.Row="2" Text="Sentences" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LinesText}" Width="80" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="1" Maximum="6" TickFrequency="1" Value="{Binding Lines}"
                                                    AutomationProperties.Name="Sentences on screen" ToolTip="How many of the latest sentences stay on screen" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="3" Text="Hide after" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding HideAfterText}" Width="80" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="0" Maximum="60" TickFrequency="1" Value="{Binding HideAfter}"
                                                    AutomationProperties.Name="Hide after" ToolTip="The text fades out this long after the last sentence (0 = stays)" />
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- Text -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="Text" Style="{StaticResource ObsSection}" />

                                        <TextBlock Grid.Row="1" Text="Font" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ChipToggle}" IsChecked="{Binding Bold}" Content="Bold"
                                                      Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Bold" />
                                            <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding FontFamily}" IsTextSearchEnabled="True"
                                                      AutomationProperties.Name="Font family" MaxDropDownHeight="320">
                                                <ComboBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ComboBox.ItemsPanel>
                                            </ComboBox>
                                        </DockPanel>

                                        <!-- Google Fonts -->
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                            <Grid>
                                                <TextBox x:Name="FontSearchBox" Text="{Binding FontQuery, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" Padding="28,0,8,0" AutomationProperties.Name="Search Google Fonts">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding InstallTypedCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" IsHitTestVisible="False"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}" />
                                                <TextBlock Text="Search Google Fonts" IsHitTestVisible="False" Margin="30,0,0,0" FontSize="12"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}"
                                                           Visibility="{Binding Text, ElementName=FontSearchBox, Converter={StaticResource VisibleWhen}, ConverterParameter=''}" />
                                            </Grid>
                                            <TextBlock Text="{Binding SearchStatus}" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                                                       Visibility="{Binding SearchStatus, Converter={StaticResource VisibleUnless}, ConverterParameter=''}" />
                                            <ItemsControl ItemsSource="{Binding FontResults}" MaxHeight="190" Margin="0,4,0,0">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FontResult}">
                                                        <DockPanel Margin="0,1,6,1">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding ActionText}"
                                                                    Command="{Binding DataContext.Obs.FontActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Family}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                                                       Foreground="{DynamicResource TertiaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                            <TextBlock Text="{Binding Family}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Text="Size" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FontSizeText}" Width="60" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="12" Maximum="200" TickFrequency="1" Value="{Binding FontSize}"
                                                    AutomationProperties.Name="Font size" />
                                        </DockPanel>

                                        <TextBlock Grid.Row="4" Text="Color" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                                            <Border DockPanel.Dock="Right" Width="30" Height="26" CornerRadius="6" Margin="8,0,0,0" BorderThickness="1"
                                                    BorderBrush="{DynamicResource DialogStrokeBrush}" Background="{Binding TextColor, Converter={StaticResource ColorBrush}}" />
                                            <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Text color" ToolTip="#RRGGBB, or #AARRGGBB with transparency first" />
                                        </DockPanel>

                                        <TextBlock Grid.Row="5" Text="Letters" Style="{StaticResource ObsLabel}" />
                                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{Binding Cases}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding Case}" AutomationProperties.Name="Letter case" />

                                        <TextBlock Grid.Row="6" Text="Align" Style="{StaticResource ObsLabel}" />
                                        <Grid Grid.Row="6" Grid.Column="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding HorizontalAligns}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding HorizontalAlign}" AutomationProperties.Name="Horizontal alignment" ToolTip="Horizontal" />
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding VerticalAligns}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding VerticalAlign}" AutomationProperties.Name="Vertical alignment" ToolTip="Vertical" />
                                        </Grid>

                                        <TextBlock Grid.Row="7" Text="Line height" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="7" Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineHeightText}" Width="60" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="0.8" Maximum="3" TickFrequency="0.05" Value="{Binding LineHeight}"
                                                    AutomationProperties.Name="Line height" />
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- Shadow -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.ColumnSpan="2">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" IsChecked="{Binding Shadow}"
                                                      VerticalAlignment="Center" AutomationProperties.Name="Text shadow" />
                                            <TextBlock Text="Text shadow" Style="{StaticResource ObsSection}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="Horizontal" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="1" Grid.Column="1" IsEnabled="{Binding Shadow}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShadowXText}" Width="60" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="-30" Maximum="30" TickFrequency="1" Value="{Binding ShadowX}"
                                                    AutomationProperties.Name="Shadow horizontal position" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="2" Text="Vertical" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="2" Grid.Column="1" IsEnabled="{Binding Shadow}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShadowYText}" Width="60" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="-30" Maximum="30" TickFrequency="1" Value="{Binding ShadowY}"
                                                    AutomationProperties.Name="Shadow vertical position" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="3" Text="Blur" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="3" Grid.Column="1" IsEnabled="{Binding Shadow}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShadowBlurText}" Width="60" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="0" Maximum="40" TickFrequency="1" Value="{Binding ShadowBlur}"
                                                    AutomationProperties.Name="Shadow blur" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="4" Text="Color" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" IsEnabled="{Binding Shadow}">
                                            <Border DockPanel.Dock="Right" Width="30" Height="26" CornerRadius="6" Margin="8,0,0,0" BorderThickness="1"
                                                    BorderBrush="{DynamicResource DialogStrokeBrush}" Background="{Binding ShadowColor, Converter={StaticResource ColorBrush}}" />
                                            <TextBox Text="{Binding ShadowColor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Shadow color" ToolTip="#RRGGBB, or #AARRGGBB with transparency first" />
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- Outline -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="Outline" Style="{StaticResource ObsSection}" />
                                        <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OutlineWidthText}" Width="60" Style="{StaticResource ObsValue}" />
                                            <Slider Style="{StaticResource ObsSlider}" Minimum="0" Maximum="20" TickFrequency="1" Value="{Binding OutlineWidth}"
                                                    AutomationProperties.Name="Outline size" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="2" Text="Color" Style="{StaticResource ObsLabel}" />
                                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                            <Border DockPanel.Dock="Right" Width="30" Height="26" CornerRadius="6" Margin="8,0,0,0" BorderThickness="1"
                                                    BorderBrush="{DynamicResource DialogStrokeBrush}" Background="{Binding OutlineColor, Converter={StaticResource ColorBrush}}" />
                                            <TextBox Text="{Binding OutlineColor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Outline color" ToolTip="#RRGGBB, or #AARRGGBB with transparency first" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Live preview: the same page OBS shows, scaled to fit, over a checkerboard where it is transparent -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource ObsSection}" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"
                                       Text="In OBS: Sources, +, Browser. Paste the address, set Width and Height to the canvas size above, and keep &quot;Shutdown source when not visible&quot; off. A Google font must be installed here to show in OBS." />
                            <Border CornerRadius="10" Background="#2C2C2C" ClipToBounds="True">
                                <Grid>
                                    <wv2:WebView2 x:Name="ObsPreview" DefaultBackgroundColor="Transparent" />
                                    <TextBlock x:Name="ObsPreviewMessage" TextWrapping="Wrap" Margin="20" FontSize="12" Foreground="#CCCCCC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
