<Project>
  <!-- dotnet publish src\WhisperStt.Desktop -p:PublishProfile=win-x64
       Produces publish\app: WalkTalk.exe with everything it needs beside it, .NET included, so nothing has
       to be installed on the target PC. The installer copies that folder as it is.
       (Not a single-file exe: one would unpack these same files into the Temp folder at every new version
       and never clean them up.) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\app\</PublishDir>
  </PropertyGroup>
</Project>
