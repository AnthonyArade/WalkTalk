<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Dark theme, after Apple's dark-mode system colors and materials:
      - Chrome (title area, sidebar) sits on the translucent Mica window material.
      - Content (the transcript) sits on a solid surface, so text stays crisp and legible.
      - Interactive elements are a lighter layer; structure is a heavier, darker one.
      Semi-transparent brushes work both over Mica and over the solid fallback background.
      Every key here must also exist in Light.xaml.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FF1C1C1E" />     <!-- fallback when Mica is unavailable -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#33000000" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF161618" />    <!-- solid content well -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FF161618" />
    <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />       <!-- lighter material: interactive -->
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="InsetBrush" Color="#33000000" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="DialogBrush" Color="#FF2C2C2E" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ToastBrush" Color="#FF2C2C2E" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />

    <!-- Labels -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF98989F" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="#FF636366" />

    <!-- Accent (system blue). AccentHoverBrush doubles as the accent's text shade. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF409CFF" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#260A84FF" />
    <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#380A84FF" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#660A84FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

    <!-- What is live: hearing you, reading aloud, an option that is on -->
    <SolidColorBrush x:Key="SpeakingBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="PulseBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#260A84FF" />
    <SolidColorBrush x:Key="ToggleOnTextBrush" Color="#FF409CFF" />
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#3DFFFFFF" />

    <!-- Chrome: toolbar and sidebar, which sit on the window material. In Dark they match the rest. -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="ChromeMutedBrush" Color="#FF98989F" />
    <SolidColorBrush x:Key="ChromeButtonBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ChromeButtonHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ChromeButtonTextBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="ChromeButtonIconBrush" Color="#FF98989F" />
    <SolidColorBrush x:Key="ChromePrimaryBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="ChromePrimaryHoverBrush" Color="#FF409CFF" />
    <SolidColorBrush x:Key="ChromePrimaryTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ChromeTintBrush" Color="#260A84FF" />
    <SolidColorBrush x:Key="ChromeTintHoverBrush" Color="#380A84FF" />
    <SolidColorBrush x:Key="ChromeTintTextBrush" Color="#FF409CFF" />
    <SolidColorBrush x:Key="SidebarCardBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SidebarCardHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PickBannerBrush" Color="#260A84FF" />
    <SolidColorBrush x:Key="PickBannerStrokeBrush" Color="#660A84FF" />

    <!-- Status: green = done, red = stop / error -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFFF6961" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#26FF453A" />
</ResourceDictionary>
